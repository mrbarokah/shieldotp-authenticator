{
  "manifest_version": 3,
  "name": "ShieldOTP \u2014 Floating Overlay Authenticator",
  "version": "3.0.0",
  "description": "0ms In-Page Floating Overlay RFC 6238 TOTP authenticator with PIN/Passkey lock & AES-256-GCM encryption.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Authenticator Overlay",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "icon48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none';"
  }
}